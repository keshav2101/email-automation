# ============================================
# HR Email Automation System - Environment
# ============================================
# Copy this file to .env and fill in values

# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@db:5432/hr_automation

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Security ---
SECRET_KEY=change-this-to-a-long-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- AI (Google Gemini) ---
GEMINI_API_KEY=your-gemini-api-key-here

# --- Gmail OAuth 2.0 ---
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/gmail/callback

# --- App ---
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
ENVIRONMENT=development

# --- File Uploads ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# --- Email Sending Limits ---
DAILY_SEND_LIMIT=50
BATCH_SEND_LIMIT=10

# --- Next.js Public ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME=HR Outreach AI
